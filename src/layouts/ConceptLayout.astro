---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ConceptMeta from '../components/concept/ConceptMeta.astro';
import ConceptCard from '../components/concept/ConceptCard.astro';
import TableOfContents from '../components/concept/TableOfContents.astro';
import { getTranslations, type Locale } from '../i18n/utils';
import { routePath } from '../i18n/routes';
import { conceptHref, type ConceptEntry } from '../components/concept/concepts';
import { breadcrumbs, personRef } from '../lib/schema';

interface Props {
	concept: ConceptEntry;
	headings: MarkdownHeading[];
	minutes: number;
	lang: Locale;
	/** True when the page is shown in a locale that has no translation of it. */
	fallback?: boolean;
	prerequisites: ConceptEntry[];
	related: ConceptEntry[];
	prev?: ConceptEntry;
	next?: ConceptEntry;
	/** Same concept under the default locale, used by the "read original" link. */
	originalHref?: string;
}

const { concept, headings, minutes, lang, fallback = false, prerequisites, related, prev, next, originalHref } = Astro.props;
const { title, summary, area, level, tags, order } = concept.data;
const t = getTranslations(lang);
const link = (e: ConceptEntry) => ({ title: e.data.title, href: conceptHref(lang, e) });
const indexHref = routePath(lang, 'concepts');
const site = Astro.site!;
const schema = [
	{
		'@type': ['Article', 'LearningResource'],
		headline: title,
		description: summary,
		url: new URL(`${conceptHref(lang, concept)}/`, site).href,
		author: personRef(site),
		educationalLevel: level,
		learningResourceType: 'interactive explanation',
		about: area,
		keywords: tags?.join(', '),
		inLanguage: 'es',
	},
	breadcrumbs(site, [
		{ name: t('nav.mlConcepts'), path: `${indexHref}/` },
		{ name: title, path: `${conceptHref(lang, concept)}/` },
	]),
];
---

<BaseLayout title={title} description={summary} lang={lang} schema={schema} canonical={fallback ? originalHref : undefined}>
	<article class="concept-page">
		<header class="concept-page__header">
			<nav class="concept-page__crumbs" aria-label="breadcrumb">
				<a href={indexHref}>{t('nav.concepts')}</a>
				<span aria-hidden="true">/</span>
				<span>{area}</span>
			</nav>
			<p class="concept-page__order">{String(order).padStart(2, '0')} · {t('concepts.path')}</p>
			<h1 class="concept-page__title">{title}</h1>
			<p class="concept-page__summary">{summary}</p>
			{tags.length > 0 && (
				<ul class="concept-page__tags">
					{tags.map((tag: string) => <li>{tag}</li>)}
				</ul>
			)}
			{fallback && (
				<p class="concept-page__notice" role="note">
					{t('concepts.spanishOnly')}
					{originalHref && <a href={originalHref}>{t('concepts.readInSpanish')}</a>}
				</p>
			)}
		</header>

		<div class="concept-page__grid">
			<div class="concept-page__body prose">
				<slot />
			</div>
			<aside class="concept-page__aside">
				<TableOfContents headings={headings} title={t('concepts.toc')} />
				<ConceptMeta
					level={level}
					area={area}
					minutes={minutes}
					prerequisites={prerequisites.map(link)}
					related={related.map(link)}
					lang={lang}
				/>
			</aside>
		</div>

		{(prev || next) && (
			<nav class="concept-page__pager" aria-label={t('concepts.path')}>
				{prev ? (
					<a class="pager pager--prev" href={conceptHref(lang, prev)} rel="prev">
						<span class="pager__label">← {t('concepts.prev')}</span>
						<span class="pager__title">{prev.data.title}</span>
					</a>
				) : <span />}
				{next ? (
					<a class="pager pager--next" href={conceptHref(lang, next)} rel="next">
						<span class="pager__label">{t('concepts.next')} →</span>
						<span class="pager__title">{next.data.title}</span>
					</a>
				) : <span />}
			</nav>
		)}

		{related.length > 0 && (
			<section class="concept-page__related">
				<h2 class="concept-page__related-title">{t('concepts.related')}</h2>
				<div class="concept-page__related-grid">
					{related.map((r) => (
						<ConceptCard
							title={r.data.title}
							summary={r.data.summary}
							href={conceptHref(lang, r)}
							level={r.data.level}
							area={r.data.area}
							lang={lang}
						/>
					))}
				</div>
			</section>
		)}
	</article>
</BaseLayout>

<style>
	.concept-page {
		padding-top: 100px;
	}
	.concept-page__header {
		padding-bottom: 36px;
		margin-bottom: 44px;
		border-bottom: 1px solid var(--rule);
	}
	.concept-page__crumbs {
		display: flex;
		gap: 8px;
		margin-bottom: 20px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.concept-page__crumbs a {
		color: var(--accent);
		text-decoration: none;
	}
	.concept-page__order {
		margin: 0 0 10px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.concept-page__title {
		margin: 0 0 16px;
		font-family: var(--font-serif);
		font-size: clamp(30px, 4vw, 48px);
		line-height: 1.12;
		font-weight: 400;
		color: var(--ink);
	}
	.concept-page__summary {
		margin: 0;
		max-width: 640px;
		font-size: 17px;
		line-height: 1.7;
		color: var(--ink-muted);
	}
	.concept-page__tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 20px 0 0;
		padding: 0;
	}
	.concept-page__tags li {
		padding: 3px 10px;
		border: 1px solid var(--rule);
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.concept-page__notice {
		margin: 24px 0 0;
		padding: 12px 16px;
		border-left: 3px solid var(--accent);
		background: var(--accent-light);
		font-size: 14px;
		color: var(--ink);
	}
	.concept-page__notice a {
		margin-left: 8px;
		color: var(--accent);
	}
	.concept-page__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 240px;
		gap: 64px;
		align-items: start;
	}
	.concept-page__aside {
		position: sticky;
		top: 40px;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}
	.concept-page__body {
		max-width: 720px;
	}
	/* Build-time rendered math (rehype-mathjax SVG) */
	.concept-page__body :global(mjx-container) {
		color: var(--ink);
	}
	.concept-page__body :global(mjx-container[display='true']) {
		display: block;
		margin: 1.75rem 0;
		overflow-x: auto;
		overflow-y: hidden;
	}
	.concept-page__body :global(.prose > h2:first-child) {
		margin-top: 0;
	}
	.concept-page__pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		margin-top: 72px;
	}
	.pager {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 18px 22px;
		border: 1px solid var(--rule);
		text-decoration: none;
		transition: border-color 0.2s;
	}
	.pager:hover {
		border-color: var(--accent);
	}
	.pager--next {
		text-align: right;
		grid-column: 2;
	}
	.pager__label {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.pager__title {
		font-family: var(--font-serif);
		font-size: 19px;
		color: var(--ink);
	}
	.concept-page__related {
		margin-top: 64px;
	}
	.concept-page__related-title {
		margin: 0 0 20px;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 400;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.concept-page__related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 16px;
	}
	@media (max-width: 900px) {
		.concept-page {
			padding-top: 40px;
		}
		.concept-page__grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}
		.concept-page__aside {
			position: static;
			order: -1;
		}
		.concept-page__pager {
			grid-template-columns: 1fr;
		}
		.pager--next {
			grid-column: auto;
		}
	}
</style>
