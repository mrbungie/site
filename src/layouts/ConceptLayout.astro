---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/ui/TagList.astro';
import ConceptMeta from '../components/concept/ConceptMeta.astro';
import { getLangFromUrl, getLevelTranslationKey, getTranslations } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
	concept: CollectionEntry<'concepts'>;
}

const { concept } = Astro.props;
const { title, summary, tags, area, level, prerequisites, related } = concept.data;

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
---

<BaseLayout title={title} description={summary} lang={lang}>
	<article>
		<header class="concept-page-header">
			<div class="concept-page-meta">
				<span class="concept-badge">{area}</span>
				<span class="concept-badge">{t(getLevelTranslationKey(level))}</span>
				{tags.slice(0, 3).map((tag: string) => (
					<span class="concept-badge" style="color: var(--ink-muted); border-color: var(--rule);">{tag}</span>
				))}
			</div>
			<h1 class="concept-page-title">{title}</h1>
			<p class="concept-page-summary">{summary}</p>
		</header>

		<div style="display: grid; grid-template-columns: 1fr 240px; gap: 60px; align-items: start;">
			<div class="prose max-w-none">
				<slot />
			</div>
			<aside style="position: sticky; top: 40px;">
				<ConceptMeta
					level={level}
					area={area}
					prerequisites={prerequisites}
					related={related}
					lang={lang}
				/>
			</aside>
		</div>
	</article>
</BaseLayout>

<style>
	@media (max-width: 900px) {
		article > div:last-child {
			grid-template-columns: 1fr !important;
		}
		aside {
			position: static !important;
		}
	}
</style>
