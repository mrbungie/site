---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { getTranslations } from '../i18n/utils';
import { routePath } from '../i18n/routes';
import type { Locale } from '../i18n/ui';
import { postHref, postSlug, isTranslation } from '../utils/blog';
import { breadcrumbs, personRef } from '../lib/schema';

interface Props {
	post: CollectionEntry<'blog'>;
	minutes: number;
	lang?: Locale;
	prev?: CollectionEntry<'blog'>;
	next?: CollectionEntry<'blog'>;
}

const { post, minutes, lang = 'es', prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
const t = getTranslations(lang);
const site = Astro.site!;
const slug = postSlug(post);
// An English page that still shows the Spanish post canonicalizes to the original.
const translated = lang === 'es' || isTranslation(post);
const selfPath = translated ? postHref(lang, slug) : postHref('es', slug);
const hasEn = (await getCollection('blog')).some((p) => p.id === `en/${slug}`);
const postLang = isTranslation(post) ? 'en' : 'es';
const schema = [
	{
		'@type': 'BlogPosting',
		headline: title,
		description,
		datePublished: pubDate.toISOString(),
		...(updatedDate && { dateModified: updatedDate.toISOString() }),
		url: new URL(selfPath, site).href,
		author: personRef(site),
		publisher: personRef(site),
		inLanguage: postLang,
		keywords: tags?.join(', '),
	},
	breadcrumbs(site, [
		{ name: 'Blog', path: `${routePath(lang, 'blog')}/` },
		{ name: title, path: selfPath },
	]),
];
---

<BaseLayout
	title={title}
	description={description}
	lang={lang}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	canonical={selfPath}
	alternates={hasEn ? { es: postHref('es', slug), en: postHref('en', slug) } : undefined}
	schema={schema}
>
	<article class="post">
		<a class="post-back" href={routePath(lang, 'blog')}>← {t('blog.all')}</a>
		<header class="post-header">
			<p class="post-meta">
				<FormattedDate date={pubDate} lang={lang} />
				<span aria-hidden="true">·</span>
				<span>{minutes} {t('blog.min')}</span>
				{updatedDate && (
					<>
						<span aria-hidden="true">·</span>
						<span>{t('blog.updated')} <FormattedDate date={updatedDate} lang={lang} /></span>
					</>
				)}
			</p>
			<h1 class="post-title">{title}</h1>
			<p class="post-lede">{description}</p>
			{tags.length > 0 && (
				<p class="post-tags">{tags.map((tag) => <span>#{tag}</span>)}</p>
			)}
		</header>

		{heroImage && (
			<Image src={heroImage} alt="" width={1344} class="post-hero" loading="eager" />
		)}

		<div class="prose post-body">
			<slot />
		</div>

		{(prev || next) && (
			<nav class="post-pager" aria-label="Posts">
				{prev ? (
					<a href={postHref(lang, prev.id)} rel="prev">
						<span>← {t('blog.prev')}</span>
						{prev.data.title}
					</a>
				) : <span />}
				{next ? (
					<a href={postHref(lang, next.id)} rel="next" class="next">
						<span>{t('blog.next')} →</span>
						{next.data.title}
					</a>
				) : <span />}
			</nav>
		)}
	</article>
</BaseLayout>

<style>
	.post { max-width: 42rem; }
	.post-back {
		display: inline-block; margin-bottom: 2rem;
		font-family: var(--font-mono); font-size: 0.75rem;
		color: var(--ink-muted); text-decoration: none;
	}
	.post-back:hover { color: var(--accent); }
	.post-hero { width: 100%; height: auto; border-radius: 0.75rem; margin: 0 0 2.5rem; }
	.post-header { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--rule); }
	.post-meta {
		display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1rem;
		font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-muted);
	}
	.post-title {
		margin: 0 0 1rem; font-family: var(--font-serif); font-weight: 400;
		font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; color: var(--ink);
	}
	.post-lede { margin: 0; font-size: 1.125rem; color: var(--ink-muted); }
	.post-tags {
		display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1rem 0 0;
		font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent);
	}
	/* Prose extras not covered by the shared .prose rules */
	.post-body :global(.prose > :first-child) { margin-top: 0; }
	.post-body :global(table) {
		display: block; width: 100%; overflow-x: auto; margin: 2rem 0;
		border-collapse: collapse; font-size: 0.9rem;
	}
	.post-body :global(th), .post-body :global(td) {
		padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--rule); text-align: left;
	}
	.post-body :global(th) { font-weight: 500; color: var(--ink); border-bottom-color: var(--ink-faint); }
	.post-body :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 3rem 0; }
	.post-body :global(h2), .post-body :global(h3) { font-family: var(--font-serif); font-weight: 400; line-height: 1.2; }
	.post-body :global(pre) { font-size: 0.85rem; line-height: 1.6; }
	.post-pager {
		display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
		margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--rule);
	}
	.post-pager a { color: var(--ink); text-decoration: none; font-family: var(--font-serif); font-size: 1.15rem; }
	.post-pager a:hover { color: var(--accent); }
	.post-pager a span {
		display: block; margin-bottom: 0.25rem;
		font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-muted);
	}
	.post-pager .next { text-align: right; }
	@media (max-width: 600px) { .post-pager { grid-template-columns: 1fr; } .post-pager .next { text-align: left; } }
</style>
