---
import BaseHead from '../components/BaseHead.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../i18n/ui';
import { getLangFromUrl, getTranslations } from '../i18n/utils';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	lang?: Locale;
	/** Equivalent page per locale (paths). Omit a locale if no translation exists. */
	alternates?: Partial<Record<Locale, string>>;
	type?: 'website' | 'article';
	noindex?: boolean;
	publishedTime?: Date;
	modifiedTime?: Date;
	/** Override the canonical URL (path or absolute URL), e.g. for Spanish fallbacks under /en. */
	canonical?: string;
	schema?: Record<string, unknown>[];
}

const { lang: langProp, ...head } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = getTranslations(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead {...head} lang={lang} />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">{t('nav.skip')}</a>
		<Sidebar lang={lang} alternates={head.alternates} />
		<div class="site-shell">
			<main id="main" class="site-main" tabindex="-1">
				<slot />
			</main>
			<Footer lang={lang} />
		</div>
	</body>
</html>
