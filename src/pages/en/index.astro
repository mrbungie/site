---
// English version — mirrors /index.astro with lang='en'
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import { routePath } from '../../i18n/routes';

const lang = 'en' as const;
const t = getTranslations(lang);

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredConcepts = (await getCollection('concepts'))
  .filter(c => c.id.startsWith(`${lang}/`) && c.data.featured && !c.data.draft)
  .slice(0, 5);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<BaseLayout title={t('site.title')} description={t('site.description')} lang={lang}>

  <section id="about" style="padding-top: 100px;">
    <div class="section-label">About</div>
    <div class="about-grid">
      <div>
        <h1 class="about-headline">
          Data & AI executive with <em>10+ years</em> scaling enterprise capabilities.
        </h1>
        <p class="about-body">
          Specialized in turning ML, GenAI, and advanced analytics capabilities into scalable financial products, operational automation, and measurable business outcomes. Track record across banking and fintech in Chile and Italy.
        </p>
        <p class="about-body">
          Currently completing an MBA at MIB Trieste School of Management (Exp. Sep. 2026) and teaching Machine Learning and Statistics at university level since 2016.
        </p>
      </div>
      <div class="about-photo-wrap">
        <img class="about-photo" src="/photo-1777897986347.jpeg" alt="Germán Oviedo" />
        <p class="about-photo-caption">Trieste, 2025</p>
      </div>
    </div>
  </section>

  <section id="work" style="padding-top: 100px;">
    <div class="section-label">Work</div>
    <div class="work-list">
      {[
        { period: 'Nov 2023 – May 2025', org: 'Banco Bci — Banking, Santiago, Chile', title: 'Head of Generative AI', desc: 'Owned corporate AI strategy and CLP 800MM+ budget. Built the GenAI Center of Excellence, achieved 26% automation over ~80K monthly inquiries. Led Gemini adoption across 9,000+ employees.', tags: ['GenAI', 'LLMs', 'RAG', 'MLOps', 'Strategy'] },
        { period: 'Mar 2022 – Nov 2023', org: 'MACH — Fintech, Santiago, Chile', title: 'Head of Analytics & Data Science', desc: 'Led team of 9 (6 Data Scientists, 3 ML Engineers) supporting 3.8M+ users. Causal impact measurement across 100+ monthly campaigns. "Next Best Action" engine on AWS.', tags: ['Causal Inference', 'AWS', 'AutoML', 'Growth'] },
        { period: 'Dec 2020 – Jan 2022', org: 'Tenpo — Fintech, Santiago, Chile', title: 'Head of Data & Analytics', desc: 'Built the data function from scratch for 1M+ customers. Raised data culture maturity from 2.0 to 4.5/5 in under a year. Data lake on GCP (BigQuery, DBT, Airflow, Looker, Kubernetes).', tags: ['GCP', 'BigQuery', 'DBT', 'Airflow'] },
        { period: 'Mar 2015 – Dec 2020', org: 'Banco Bci — Santiago, Chile', title: 'Principal Data Scientist', desc: '20+ XGBoost models for behavioral prediction. Hybrid CRM engine analyzing 400K+ customers daily. COVID-19 macro-monitoring framework (NBER-style).', tags: ['Python', 'XGBoost', 'SQL', 'CRM'] },
      ].map(item => (
        <div class="work-item" style="cursor: default;">
          <div class="work-year">{item.period}</div>
          <div>
            <div style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px;">{item.org}</div>
            <div class="work-title">{item.title}</div>
            <p class="work-desc">{item.desc}</p>
            <div class="work-tags">{item.tags.map(tag => <span class="tag">{tag}</span>)}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  {allPosts.length > 0 && (
    <section id="writing" style="padding-top: 100px;">
      <div class="section-label" style="justify-content: space-between;">
        <span>Writing</span>
        <a href={routePath(lang, 'blog')} style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--ink-muted)'">All posts →</a>
      </div>
      <div class="writing-list">
        {allPosts.slice(0, 5).map(post => (
          <a href={`/blog/${post.id}/`} class="writing-item" style="text-decoration: none;">
            <div class="writing-date">{formatDate(post.data.pubDate)}</div>
            <div>
              <div class="writing-title">{post.data.title}</div>
              {post.data.description && <p class="writing-excerpt">{post.data.description}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {featuredConcepts.length > 0 && (
    <section id="concepts" style="padding-top: 100px;">
      <div class="section-label" style="justify-content: space-between;">
        <span>Concepts</span>
        <a href={routePath(lang, 'concepts')} style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--ink-muted)'">Browse all →</a>
      </div>
      <div class="concept-list">
        {featuredConcepts.map(concept => (
          <a href={routePath(lang, 'concepts', concept.id.split('/')[1].replace(/\.(mdx|md)$/, ''))} class="concept-item">
            <div class="concept-area">{concept.data.area}</div>
            <div>
              <div class="concept-title">{concept.data.title}</div>
              <p class="concept-summary">{concept.data.summary}</p>
            </div>
            <div class="work-arrow">↗</div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section id="resume" style="padding-top: 100px;">
    <div class="section-label">Résumé</div>

    <div class="resume-section">
      <div class="resume-section-title">Professional Experience</div>
      {[
        { period: 'Nov 2023\nMay 2025', org: 'Banco Bci', role: 'Head of Generative AI', detail: 'Corporate AI strategy, CLP 800MM+ budget. GenAI CoE (3 ML Engineers, 2 Product Leads). 26% automation over ~80K monthly inquiries. Led Gemini across 9,000+ employees.' },
        { period: 'Mar 2022\nNov 2023', org: 'MACH', role: 'Head of Analytics & Data Science', detail: 'Team of 9 for 3.8M+ users. Causal inference across 100+ monthly campaigns. "Next Best Action" engine on AWS. AutoML + GPT-based DataBot.' },
        { period: 'Dec 2020\nJan 2022', org: 'Tenpo', role: 'Head of Data & Analytics', detail: 'Built data function from scratch for 1M+ customers. Data culture 2.0 → 4.5/5. Data lake on GCP (BigQuery, DBT, Airflow, Looker, Kubernetes).' },
        { period: 'Mar 2015\nDec 2020', org: 'Banco Bci', role: 'Principal Data Scientist', detail: '20+ XGBoost models. Hybrid CRM engine for 400K+ daily customers. COVID-19 macro-monitoring framework.' },
      ].map(item => (
        <div class="resume-item">
          <div class="resume-period" style="white-space: pre-line;">{item.period}</div>
          <div>
            <div class="resume-org">{item.org}</div>
            <div class="resume-title-role">{item.role}</div>
            <p class="resume-detail">{item.detail}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="resume-section">
      <div class="resume-section-title">Education</div>
      <div class="resume-item">
        <div class="resume-period">2024 – 2026</div>
        <div>
          <div class="resume-org">MIB Trieste School of Management</div>
          <div class="resume-title-role">MBA in International Business</div>
          <p class="resume-detail">In collaboration with University of Trieste. Expected Sep. 2026.</p>
        </div>
      </div>
      <div class="resume-item">
        <div class="resume-period">2021 – 2022</div>
        <div>
          <div class="resume-org">Universidad Adolfo Ibáñez</div>
          <div class="resume-title-role">M.Sc. in Engineering, IT specialization</div>
          <p class="resume-detail">Santiago & Viña del Mar, Chile</p>
        </div>
      </div>
      <div class="resume-item">
        <div class="resume-period">2010 – 2015</div>
        <div>
          <div class="resume-org">Universidad Adolfo Ibáñez</div>
          <div class="resume-title-role">B.Sc. in Engineering (Industrial Engineering)</div>
          <p class="resume-detail">Santiago & Viña del Mar, Chile</p>
        </div>
      </div>
    </div>

    <div class="resume-section">
      <div class="resume-section-title">Technical Skills</div>
      <div style="display: flex; flex-direction: column; gap: 10px; font-size: 13px; color: var(--ink-muted); line-height: 1.7;">
        <div><span style="color: var(--ink); font-weight: 500;">GenAI & ML:</span> LLMs, RAG, LangGraph, PydanticAI, MLOps, model evaluation</div>
        <div><span style="color: var(--ink); font-weight: 500;">Data & Platforms:</span> BigQuery, Snowflake, DBT, Airflow, Spark, feature stores, data governance</div>
        <div><span style="color: var(--ink); font-weight: 500;">Cloud:</span> AWS (Glue, Athena), GCP, Azure · Kubernetes, Terraform</div>
        <div><span style="color: var(--ink); font-weight: 500;">Analytics:</span> Causal inference, A/B testing, quasi-experiments, marketing analytics</div>
        <div><span style="color: var(--ink); font-weight: 500;">Programming:</span> Python (numpy, pytorch, tensorflow), SQL, Spark (Java, Scala), R</div>
        <div><span style="color: var(--ink); font-weight: 500;">Languages:</span> Spanish (native), English (professional)</div>
      </div>
    </div>

    <a class="cv-download" href="/GermanOviedo_CV_EN.pdf" download>Download full résumé ↓</a>
  </section>

  <section id="contact" style="padding-top: 100px; padding-bottom: 120px;">
    <div class="section-label">Contact</div>
    <h2 class="contact-headline">Let's work on something that matters.</h2>
    <p class="contact-body">
      Open to data & AI leadership roles, advisory work, ML contractor projects, teaching, and speaking. I move between Europe and Latin America — remote-first, in-person when it counts.
    </p>
    <div class="contact-links">
      <a class="contact-link-row" href="mailto:german.oviedo.b@gmail.com">
        <span class="contact-link-label">Email</span>
        <span class="contact-link-value">german.oviedo.b@gmail.com</span>
      </a>
      <a class="contact-link-row" href="https://linkedin.com/in/goviedb" target="_blank">
        <span class="contact-link-label">LinkedIn</span>
        <span class="contact-link-value">linkedin.com/in/goviedb</span>
      </a>
      <a class="contact-link-row" href="https://github.com/mrbungie" target="_blank">
        <span class="contact-link-label">GitHub</span>
        <span class="contact-link-value">github.com/mrbungie</span>
      </a>
    </div>
  </section>

</BaseLayout>
