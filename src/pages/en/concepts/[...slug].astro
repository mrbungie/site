---
import ConceptPage from '../../../components/concept/ConceptPage.astro';
import { getConceptPaths } from '../../../components/concept/conceptRoutes';

export async function getStaticPaths() {
	// No English translations yet: falls back to the Spanish entries (flagged on the page).
	return getConceptPaths('en');
}

const { concept } = Astro.props;
---

<ConceptPage concept={concept} lang="en" />
