---
import PostPage from '../../components/blog/PostPage.astro';
import { getPosts, postSlug } from '../../utils/blog';

export async function getStaticPaths() {
	return (await getPosts('es')).map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
---

<PostPage post={post} lang="es" />
