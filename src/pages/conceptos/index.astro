---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getLangFromUrl } from '../../i18n/utils';
import { routePath } from '../../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

const concepts = (await getCollection('concepts'))
	.filter(c => c.id.startsWith(`${lang}/`) && !c.data.draft)
	.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={t('concepts.title')} description={t('concepts.subtitle')} lang={lang}>
	<section style="padding-top: 100px;">
		<div class="section-label">{t('nav.concepts')}</div>
		<h1 style="font-family: var(--font-serif); font-size: clamp(28px, 3.5vw, 42px); line-height: 1.15; color: var(--ink); margin-bottom: 12px;">
			{t('concepts.title')}
		</h1>
		<p style="font-size: 15px; color: var(--ink-muted); line-height: 1.75; max-width: 480px; margin-bottom: 48px;">
			{t('concepts.subtitle')}
		</p>

		<div class="concept-list">
			{concepts.map((concept) => (
				<a
					href={routePath(lang, 'concepts', concept.id.split('/')[1].replace(/\.(mdx|md)$/, ''))}
					class="concept-item"
				>
					<div class="concept-area">{concept.data.area}</div>
					<div>
						<div class="concept-title">{concept.data.title}</div>
						<p class="concept-summary">{concept.data.summary}</p>
					</div>
					<div class="work-arrow">↗</div>
				</a>
			))}
		</div>
	</section>
</BaseLayout>
