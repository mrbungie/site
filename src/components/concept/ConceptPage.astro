---
import { render } from 'astro:content';
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { routePath } from '../../i18n/routes';
import { defaultLocale, type Locale } from '../../i18n/ui';
import { conceptHref, getConcepts, readingMinutes, resolveRefs, conceptSlug, type ConceptEntry } from './concepts';

interface Props {
	concept: ConceptEntry;
	lang: Locale;
}

const { concept, lang } = Astro.props;
const { entries, fallback } = await getConcepts(lang);
const { Content, headings } = await render(concept);

const slug = conceptSlug(concept);
const index = entries.findIndex((e) => e.id === concept.id);
const prerequisites = resolveRefs(entries, concept.data.prerequisites, slug);
const related = resolveRefs(entries, concept.data.related, slug);
const originalHref = fallback ? routePath(defaultLocale, 'concepts', slug) : undefined;

// hreflang pair only when both languages really have this concept
const other: Locale = lang === 'es' ? 'en' : 'es';
const otherSet = await getConcepts(other);
const hasOther = !otherSet.fallback && otherSet.entries.some((e) => conceptSlug(e) === slug);
const alternates = !fallback && hasOther
	? { es: `${routePath('es', 'concepts', slug)}/`, en: `${routePath('en', 'concepts', slug)}/` }
	: undefined;
---

<ConceptLayout
	concept={concept}
	headings={headings}
	minutes={readingMinutes(concept)}
	lang={lang}
	fallback={fallback}
	prerequisites={prerequisites}
	related={related}
	prev={entries[index - 1]}
	next={entries[index + 1]}
	originalHref={originalHref}
	alternates={alternates}
>
	<Content />
</ConceptLayout>
