---
import { getLevelTranslationKey, getTranslations, type Level, type Locale } from '../../i18n/utils';

interface Link {
	title: string;
	href: string;
}
interface Props {
	level: Level;
	area: string;
	minutes: number;
	prerequisites?: Link[];
	related?: Link[];
	lang: Locale;
}

const { level, area, minutes, prerequisites = [], related = [], lang } = Astro.props;
const t = getTranslations(lang);
---

<div class="concept-meta">
	<dl class="concept-meta__facts">
		<div>
			<dt>{t('concepts.area')}</dt>
			<dd>{area}</dd>
		</div>
		<div>
			<dt>{t('concepts.level')}</dt>
			<dd>{t(getLevelTranslationKey(level))}</dd>
		</div>
		<div>
			<dt>{minutes} {t('concepts.minRead')}</dt>
		</div>
	</dl>

	{prerequisites.length > 0 && (
		<div>
			<h2 class="concept-meta__heading">{t('concepts.prerequisites')}</h2>
			<ul class="concept-meta__links">
				{prerequisites.map((p) => <li><a href={p.href}>{p.title}</a></li>)}
			</ul>
		</div>
	)}

	{related.length > 0 && (
		<div>
			<h2 class="concept-meta__heading">{t('concepts.related')}</h2>
			<ul class="concept-meta__links">
				{related.map((r) => <li><a href={r.href}>{r.title}</a></li>)}
			</ul>
		</div>
	)}
</div>

<style>
	.concept-meta {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}
	.concept-meta__facts {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.concept-meta__facts dt,
	.concept-meta__heading {
		margin: 0 0 6px;
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 400;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.concept-meta__facts dd {
		margin: 0;
		font-size: 14px;
		color: var(--ink);
	}
	.concept-meta__links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.concept-meta__links a {
		font-size: 14px;
		color: var(--ink-muted);
		text-decoration: none;
		transition: color 0.2s;
	}
	.concept-meta__links a::before {
		content: '→ ';
	}
	.concept-meta__links a:hover {
		color: var(--accent);
	}
</style>
