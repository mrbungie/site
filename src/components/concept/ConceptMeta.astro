---
import { getLevelTranslationKey, getTranslations, localePath, type Level, type Locale } from '../../i18n/utils';

interface Props {
	level: Level;
	area: string;
	prerequisites?: string[];
	related?: string[];
	lang: Locale;
}

const { level, area, prerequisites = [], related = [], lang } = Astro.props;
const t = getTranslations(lang);
---

<div style="border: 1px solid var(--rule); padding: 24px; display: flex; flex-direction: column; gap: 20px;">
	<div>
		<div style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 8px;">{t('concepts.level')}</div>
		<span class="concept-badge">{t(getLevelTranslationKey(level))}</span>
	</div>

	<div>
		<div style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 8px;">{t('concepts.area')}</div>
		<span style="font-family: var(--font-mono); font-size: 11px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.06em;">{area}</span>
	</div>

	{prerequisites.length > 0 && (
		<div>
			<div style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 8px;">{t('concepts.prerequisites')}</div>
			<ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 6px;">
				{prerequisites.map((p: string) => (
					<li>
						<a href={localePath(lang, `/conceptos/${p}`)} style="font-family: var(--font-mono); font-size: 11px; color: var(--ink-muted); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--ink-muted)'">
							→ {p.split('-').map((word: string) => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')}
						</a>
					</li>
				))}
			</ul>
		</div>
	)}

	{related.length > 0 && (
		<div>
			<div style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 8px;">{t('concepts.related')}</div>
			<ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 6px;">
				{related.map((r: string) => (
					<li>
						<a href={localePath(lang, `/conceptos/${r}`)} style="font-family: var(--font-mono); font-size: 11px; color: var(--ink-muted); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--ink-muted)'">
							→ {r.split('-').map((word: string) => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')}
						</a>
					</li>
				))}
			</ul>
		</div>
	)}
</div>
