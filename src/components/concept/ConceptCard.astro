---
import { getTranslations, type Locale } from '../../i18n/utils';

interface Props {
	title: string;
	summary: string;
	href: string;
	level: 'beginner' | 'intermediate' | 'advanced';
	area: string;
	lang: Locale;
}

const { title, summary, href, level, area, lang } = Astro.props;
---

<a href={href} class="concept-item">
	<div class="concept-area">{area}</div>
	<div>
		<div class="concept-title">{title}</div>
		<p class="concept-summary">{summary}</p>
	</div>
	<div class="work-arrow">↗</div>
</a>
