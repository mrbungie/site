---
// Funnel diagram: each stage narrows the data from the one above.
import type { FunnelSpec } from './diagrams';

type Props = FunnelSpec;
const { label, stages, note } = Astro.props;
const step = stages.length > 1 ? 45 / (stages.length - 1) : 0; // last stage is 55% wide
---

<figure class="funnel" role="img" aria-label={label}>
  <ol class="funnel__stages">
    {stages.map((stage, i) => (
      <li
        class:list={['funnel__stage', { 'funnel__stage--accent': stage.accent }]}
        style={`--w: ${100 - i * step}%`}
      >
        <span class="funnel__title">{stage.title}</span>
        <span class="funnel__sub">{stage.sub}</span>
      </li>
    ))}
  </ol>
  {note && <figcaption class="funnel__note">{note}</figcaption>}
</figure>

<style>
  .funnel { margin: 0; }
  .funnel__stages { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .funnel__stage {
    width: var(--w);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 12px 16px;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
  }
  .funnel__stage--accent { border-color: var(--accent); background: var(--accent-light); }
  .funnel__title { font-family: var(--font-serif); font-size: var(--text-lg); color: var(--ink); }
  .funnel__stage--accent .funnel__title { color: var(--accent); }
  .funnel__sub { font-size: var(--text-sm); line-height: 1.45; color: var(--ink-muted); max-width: 52ch; }
  .funnel__note { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--ink-muted); text-align: center; }
  @media (max-width: 560px) {
    .funnel__stage { width: 100%; }
  }
</style>
