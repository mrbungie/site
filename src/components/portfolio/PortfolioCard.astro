---
import type { Locale } from '../../i18n/ui';
import type { Project } from '../../data/portfolio';
import { labels, projectHref } from './labels';

interface Props { project: Project; lang: Locale; compact?: boolean }
const { project: p, lang, compact = false } = Astro.props;
const t = labels[lang];
// The whole card opens the project; only external links get their own button.
const external = [
  p.pdf && { href: p.pdf, label: 'PDF' },
  p.repo && { href: p.repo, label: 'GitHub' },
  p.paper && { href: p.paper, label: 'arXiv' },
].filter((x) => !!x).slice(0, 1); // one button so the footer never wraps; the rest live on the detail page
---

<article class:list={['pcard', { 'pcard--compact': compact }]}>
  <div class="pcard__top">
    <span class:list={['kind-badge', `kind-badge--${p.kind}`]}>{t[p.kind]}</span>
    <span class="pcard__period">{p.period}</span>
  </div>
  <h3 class="pcard__title">
    <a class="pcard__link" href={projectHref(lang, p)}>{p.title[lang]}</a>
  </h3>
  <p class="pcard__meta" title={`${p.industry[lang]} · ${p.workType[lang]}`}>{p.industry[lang]} · {p.workType[lang]}</p>
  <p class="pcard__via">{p.via && `${t.via} ${p.via.name} · ${t.founding}`}</p>
  {!compact && <p class="pcard__summary">{p.summary[lang]}</p>}
  {!compact && <p class="pcard__stack">{p.stack.slice(0, 4).join(' · ')}</p>}
  <div class="pcard__foot">
    <span class="pcard__cta" aria-hidden="true">{t.view} <span class="pcard__arrow">→</span></span>
    {external.length > 0 && (
      <div class="pcard__exts">
        {external.map((x) => <a class="pcard__ext" href={x.href} target="_blank" rel="noopener">{x.label} ↗</a>)}
      </div>
    )}
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur-fast), transform var(--dur-fast), box-shadow var(--dur-fast);
  }
  .pcard:hover, .pcard:focus-within { border-color: var(--accent); }
  .pcard:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  /* Hovering the external button shouldn't look like it opens the card */
  .pcard:has(.pcard__ext:hover) { transform: none; box-shadow: none; border-color: var(--rule); }
  .pcard__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1); }
  .pcard__period { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--ink-faint); }
  /* Every section has a fixed number of lines so cards line up regardless of content */
  .pcard__title, .pcard__meta, .pcard__via, .pcard__summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pcard__title { --lines: 3; -webkit-line-clamp: 3; min-height: calc(var(--lines) * 1lh); font-family: var(--font-serif); font-weight: 400; font-size: var(--text-xl); line-height: var(--leading-snug); margin: 0; }
  .pcard__link { color: var(--ink); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; text-decoration-thickness: 1px; transition: text-decoration-color var(--dur-fast); }
  .pcard__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .pcard__link:focus-visible { outline: none; }
  .pcard:hover .pcard__link, .pcard:focus-within .pcard__link { text-decoration-color: var(--accent); }
  .pcard:has(.pcard__ext:hover) .pcard__link { text-decoration-color: transparent; }
  .pcard__meta {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.6;
    -webkit-line-clamp: 2;
    min-height: 2lh;
    color: var(--accent);
    margin: 0;
  }
  .pcard__via { -webkit-line-clamp: 1; min-height: 1lh; font-size: var(--text-xs); line-height: 1.5; color: var(--ink-faint); margin: 0; }
  .pcard__summary { -webkit-line-clamp: 3; min-height: 3lh; font-size: var(--text-sm); line-height: 1.6; color: var(--ink-muted); margin: var(--space-1) 0 0; }
  .pcard__stack { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--ink-faint); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pcard__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    height: calc(28px + var(--space-3));
    box-sizing: border-box;
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }
  .pcard__cta {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .pcard__arrow { display: inline-block; color: var(--accent); transition: transform var(--dur-fast); }
  .pcard:hover .pcard__arrow { transform: translateX(4px); }
  .pcard:has(.pcard__ext:hover) .pcard__arrow { transform: none; }
  .pcard__exts { display: flex; gap: 6px; }
  .pcard__ext {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    padding: 4px 7px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm, 4px);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }
  .pcard__ext:hover, .pcard__ext:focus-visible { border-color: var(--accent); color: var(--accent); }
  .pcard--compact { padding: var(--space-4); }
  .pcard--compact .pcard__title { font-size: var(--text-lg); }
</style>
