---
import type { Locale } from '../../i18n/ui';
import type { Project } from '../../data/portfolio';
import { labels, projectHref } from './labels';

interface Props { project: Project; lang: Locale; compact?: boolean }
const { project: p, lang, compact = false } = Astro.props;
const t = labels[lang];
---

<article class:list={['pcard', { 'pcard--compact': compact }]}>
  <div class="pcard__top">
    <span class:list={['kind-badge', `kind-badge--${p.kind}`]}>{t[p.kind]}</span>
    <span class="pcard__period">{p.period}</span>
  </div>
  <h3 class="pcard__title">
    <a class="pcard__link" href={projectHref(lang, p)}>{p.title[lang]}</a>
  </h3>
  <p class="pcard__meta">{p.industry[lang]} · {p.workType[lang]}</p>
  {p.via && (
    <p class="pcard__via">
      {t.via} {p.via.url ? <a class="pcard__firm" href={p.via.url} target="_blank" rel="noopener">{p.via.name}</a> : p.via.name} ({t.founding})
    </p>
  )}
  {!compact && <p class="pcard__summary">{p.summary[lang]}</p>}
  <div class="pcard__foot">
    {!compact && <div class="tag-list">{p.stack.slice(0, 4).map((s) => <span class="tag">{s}</span>)}</div>}
    {p.repo && <a class="pcard__repo" href={p.repo} target="_blank" rel="noopener">GitHub ↗</a>}
    {p.paper && <a class="pcard__repo" href={p.paper} target="_blank" rel="noopener">arXiv ↗</a>}
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur-fast), transform var(--dur-fast), box-shadow var(--dur-fast);
  }
  .pcard:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .pcard:focus-within { border-color: var(--accent); }
  .pcard__top { display: flex; justify-content: space-between; align-items: center; }
  .pcard__period { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--ink-faint); }
  .pcard__title { font-family: var(--font-serif); font-weight: 400; font-size: var(--text-xl); line-height: var(--leading-snug); margin: 0; }
  .pcard__link { color: var(--ink); text-decoration: none; }
  .pcard__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .pcard__link:focus-visible { outline: none; }
  .pcard__meta {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }
  .pcard__via { font-size: var(--text-xs); color: var(--ink-faint); margin: 0; }
  .pcard__firm { position: relative; z-index: 1; color: var(--ink-muted); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 2px; }
  .pcard__firm:hover { color: var(--accent); text-decoration-color: currentColor; }
  .pcard__summary { font-size: var(--text-sm); line-height: 1.6; color: var(--ink-muted); margin: 0; flex: 1; }
  .pcard__foot { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-3); margin-top: var(--space-2); }
  .pcard__repo {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .pcard__repo:hover { color: var(--accent); }
  .pcard--compact { padding: var(--space-4); gap: var(--space-2); }
  .pcard--compact .pcard__title { font-size: var(--text-lg); }
</style>
