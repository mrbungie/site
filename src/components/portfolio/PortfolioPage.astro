---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Diagram from './Diagram.astro';
import { diagramFor } from './diagrams';
import type { Locale } from '../../i18n/ui';
import { caseStudies, repos } from '../../data/portfolio';
import { contact } from '../../data/profile';

interface Props { lang: Locale }
const { lang } = Astro.props;

const t = {
  es: {
    title: 'Portafolio',
    desc: 'Proyectos de Germán Oviedo: plataformas de datos, ML y GenAI para clientes, y repositorios abiertos.',
    intro: 'Dos tipos de trabajo. Los proyectos para clientes son confidenciales, así que solo muestro la arquitectura y lo que hice. El código abierto está en GitHub.',
    clients: 'Proyectos para clientes',
    goal: 'Objetivo',
    did: 'Lo que hice',
    code: 'Código abierto',
    all: 'Todo en GitHub ↗',
  },
  en: {
    title: 'Portfolio',
    desc: 'Projects by Germán Oviedo: data, ML and GenAI platforms for clients, and open-source repositories.',
    intro: 'Two kinds of work. Client projects are confidential, so I only show the architecture and what I did. Open-source code is on GitHub.',
    clients: 'Client projects',
    goal: 'Goal',
    did: 'What I did',
    code: 'Open source',
    all: 'All on GitHub ↗',
  },
}[lang];
---

<BaseLayout title={`${t.title} · Germán Oviedo`} description={t.desc} lang={lang}>
  <section class="portfolio">
    <div class="section-label">{t.title}</div>
    <h1 class="portfolio__title">{t.title}</h1>
    <p class="portfolio__intro">{t.intro}</p>

    <h2 class="portfolio__heading">{t.clients}</h2>
    {caseStudies.map((c) => {
      const d = diagramFor(c.id, lang);
      return (
        <article class="case" id={c.id}>
          <header class="case__header">
            <p class="case__meta">{c.context[lang]} · {c.period}</p>
            <h3 class="case__title">{c.title[lang]}</h3>
          </header>
          <Diagram {...d} />
          <div class="case__body">
            <div>
              <p class="case__label">{t.goal}</p>
              <p class="case__text">{c.goal[lang]}</p>
            </div>
            <div>
              <p class="case__label">{t.did}</p>
              <ul class="case__list">{c.did[lang].map((item) => <li>{item}</li>)}</ul>
            </div>
          </div>
          <div class="tag-list">{c.stack.map((s) => <span class="tag">{s}</span>)}</div>
        </article>
      );
    })}

    <div class="portfolio__split">
      <h2 class="portfolio__heading">{t.code}</h2>
      <a class="portfolio__more" href={contact.github.url} target="_blank" rel="noopener">{t.all}</a>
    </div>
    <div class="work-list">
      {repos.map((r) => (
        <a class="work-item repo" href={r.url} target="_blank" rel="noopener">
          <div class="work-year">{r.year}</div>
          <div>
            <div class="work-title repo__name">{r.name}</div>
            <p class="work-desc">{r.desc[lang]}</p>
            <div class="work-tags">{r.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          </div>
          <div class="work-arrow">↗</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio { padding: clamp(56px, 9vw, 100px) 0 120px; }
  .portfolio__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-4);
  }
  .portfolio__intro { max-width: 62ch; color: var(--ink-muted); line-height: var(--leading-body); margin: 0 0 var(--space-8); }
  .portfolio__heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-5);
  }
  .portfolio__split { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); margin-top: var(--space-8); }
  .portfolio__more {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .portfolio__more:hover { color: var(--ink); }

  .case { padding: var(--space-6) 0; border-top: 1px solid var(--rule); }
  .case + .case { margin-top: var(--space-4); }
  .case__header { margin-bottom: var(--space-5); }
  .case__meta {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-2);
  }
  .case__title { font-family: var(--font-serif); font-weight: 400; font-size: var(--text-xl); margin: 0; }
  .case__body { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-6); margin: var(--space-5) 0; }
  .case__label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 var(--space-2);
  }
  .case__text, .case__list { font-size: var(--text-sm); line-height: 1.65; color: var(--ink-muted); margin: 0; }
  .case__list { padding-left: 1.1em; list-style: disc; display: flex; flex-direction: column; gap: var(--space-2); }
  .case__list li::marker { color: var(--accent); }

  .repo { text-decoration: none; color: inherit; }
  .repo__name { font-family: var(--font-mono); font-size: var(--text-base); }

  @media (max-width: 760px) {
    .case__body { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>
