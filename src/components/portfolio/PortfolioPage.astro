---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';
import { featuredProjects, archivedProjects } from '../../data/portfolio';
import PortfolioCard from './PortfolioCard.astro';
import { labels, projectHref } from './labels';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = labels[lang];
---

<BaseLayout title={`${t.title} · Germán Oviedo`} description={t.desc} lang={lang}>
  <section class="portfolio">
    <div class="section-label">{t.title}</div>
    <h1 class="portfolio__title">{t.title}</h1>
    <p class="portfolio__intro">{t.intro}</p>

    <h2 class="portfolio__heading">{t.featured}</h2>
    <div class="portfolio__grid">
      {featuredProjects.map((p) => <PortfolioCard project={p} lang={lang} />)}
    </div>

    <h2 class="portfolio__heading portfolio__heading--archive">{t.archive}</h2>
    <div class="portfolio__grid portfolio__grid--archive">
      {archivedProjects.map((p) => <PortfolioCard project={p} lang={lang} compact />)}
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio { padding: clamp(56px, 9vw, 100px) 0 120px; }
  .portfolio__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-4);
  }
  .portfolio__intro { max-width: 62ch; color: var(--ink-muted); line-height: var(--leading-body); margin: 0 0 var(--space-7); }
  .portfolio__heading {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 var(--space-4);
  }
  .portfolio__heading--archive { margin-top: var(--space-8); }
  .portfolio__grid--archive { grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: var(--space-3); }
  .portfolio__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: var(--space-4); }

</style>
