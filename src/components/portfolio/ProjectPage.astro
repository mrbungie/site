---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Diagram from './Diagram.astro';
import StackDiagram from './StackDiagram.astro';
import FunnelDiagram from './FunnelDiagram.astro';
import { diagramFor } from './diagrams';
import type { Locale } from '../../i18n/ui';
import { routePath } from '../../i18n/routes';
import type { Project } from '../../data/portfolio';
import { profile } from '../../data/profile';
import { labels, projectHref } from './labels';
import { contactHref } from '../services/labels';
import { breadcrumbs, personRef } from '../../lib/schema';

interface Props { project: Project; lang: Locale }
const { project: p, lang } = Astro.props;
const t = labels[lang];
const spec = diagramFor(p.slug, lang);
const site = Astro.site!;
const work = {
  name: p.title[lang],
  headline: p.title[lang],
  description: p.summary[lang],
  url: new URL(projectHref(lang, p), site).href,
  author: personRef(site),
  keywords: p.stack.join(', '),
  about: p.industry[lang],
};
const schema = [
  p.kind === 'oss'
    ? { '@type': 'SoftwareSourceCode', ...work, codeRepository: p.repo }
    : p.kind === 'paper'
      ? { '@type': 'ScholarlyArticle', ...work, sameAs: p.paper }
      : { '@type': 'CreativeWork', ...work },
  breadcrumbs(site, [
    { name: profile.name, path: lang === 'es' ? '/' : `/${lang}/` },
    { name: t.title, path: `${routePath(lang, 'portfolio')}/` },
    { name: p.title[lang], path: projectHref(lang, p) },
  ]),
];
const alternates = { es: projectHref('es', p), en: projectHref('en', p) };
---

<BaseLayout title={`${p.title[lang]} · Germán Oviedo`} description={p.summary[lang]} lang={lang} alternates={alternates} type="article" schema={schema}>
  <article class="project">
    <a class="project__back" href={`${routePath(lang, 'portfolio')}/`}>{t.back}</a>

    <header class="project__header">
      <span class:list={['kind-badge', `kind-badge--${p.kind}`]}>{t[p.kind]}</span>
      <h1 class="project__title">{p.title[lang]}</h1>
      <dl class="project__facts">
        <div><dt>{t.industry}</dt><dd>{p.industry[lang]}</dd></div>
        <div><dt>{t.workType}</dt><dd>{p.workType[lang]}</dd></div>
        <div><dt>{t.period}</dt><dd>{p.period}</dd></div>
      </dl>
      {p.repo
        ? <a class="project__repo" href={p.repo} target="_blank" rel="noopener">{t.repo}</a>
        : p.paper
          ? <a class="project__repo" href={p.paper} target="_blank" rel="noopener">{t.arxiv}</a>
        : p.site
          ? <a class="project__repo" href={p.site} target="_blank" rel="noopener">{t.site}</a>
          : <p class="project__note">{t.confidential}</p>}
    </header>

    <section class="project__section">
      <h2 class="project__label">{t.architecture}</h2>
      {spec.type === 'stack' ? <StackDiagram {...spec} />
        : spec.type === 'funnel' ? <FunnelDiagram {...spec} />
        : <Diagram {...spec} />}
    </section>

    <div class="project__body">
      <section>
        <h2 class="project__label">{t.goal}</h2>
        <p class="project__text">{p.goal[lang]}</p>
      </section>
      <section>
        <h2 class="project__label">{t.did}</h2>
        <ul class="project__list">{p.did[lang].map((item) => <li>{item}</li>)}</ul>
      </section>
    </div>

    {p.results && (
      <section class="project__section">
        <h2 class="project__label">{t.results}</h2>
        <dl class="project__results">
          {p.results.map((r) => (
            <div>
              <dt>{r.value}</dt>
              <dd>{r.label[lang]}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <section class="project__section">
      <h2 class="project__label">{t.stack}</h2>
      <div class="tag-list">{p.stack.map((s) => <span class="tag">{s}</span>)}</div>
    </section>

    <aside class="project__cta">
      <div>
        <p class="project__cta-title">{t.ctaTitle}</p>
        <p class="project__cta-body">{t.ctaBody}</p>
      </div>
      <a class="project__repo" href={contactHref(lang)}>{t.ctaLink}</a>
    </aside>
  </article>
</BaseLayout>

<style>
  .project { padding: clamp(40px, 7vw, 80px) 0 120px; max-width: 880px; }
  .project__back {
    display: inline-block;
    margin-bottom: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .project__back:hover { color: var(--accent); }
  .project__header { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); margin-bottom: var(--space-7); }
  .project__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    margin: 0;
    text-wrap: balance;
  }
  .project__facts { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); margin: 0; }
  .project__facts dt,
  .project__label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 var(--space-2);
  }
  .project__facts dd { margin: 0; font-size: var(--text-sm); color: var(--ink); }
  .project__repo {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--ink);
    padding: 12px 18px;
    text-decoration: none;
    transition: background var(--dur-fast);
  }
  .project__repo:hover { background: var(--accent); }
  .project__note { margin: 0; font-size: var(--text-sm); color: var(--ink-muted); }
  .project__section { margin-bottom: var(--space-7); }
  .project__body { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-6); margin-bottom: var(--space-7); }
  .project__text, .project__list { font-size: var(--text-base); line-height: var(--leading-body); color: var(--ink-muted); margin: 0; }
  .project__list { padding-left: 1.1em; list-style: disc; display: flex; flex-direction: column; gap: var(--space-2); }
  .project__list li::marker { color: var(--accent); }
  .project__results { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-4); margin: 0; }
  .project__results div { padding: var(--space-4); background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-md); }
  .project__results dt { font-family: var(--font-serif); font-size: var(--text-2xl); line-height: 1; color: var(--accent); margin-bottom: var(--space-2); }
  .project__results dd { margin: 0; font-size: var(--text-sm); line-height: 1.5; color: var(--ink-muted); }
  .project__cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-5);
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--accent-light);
  }
  .project__cta-title { font-family: var(--font-serif); font-size: var(--text-xl); color: var(--ink); margin: 0 0 var(--space-1); }
  .project__cta-body { font-size: var(--text-sm); color: var(--ink-muted); margin: 0; }
  @media (max-width: 760px) {
    .project__body { grid-template-columns: 1fr; }
  }
</style>
