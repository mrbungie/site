---
// Global <head>: styles, fonts, theme bootstrap, SEO, social cards, structured data.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { AUTHOR, DEFAULT_OG_IMAGE, SITE_NAME, THEME_COLOR, THEME_STORAGE_KEY } from '../consts';
import { locales, type Locale } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
import { switchLocalePath } from '../i18n/routes';

interface Props {
	title: string;
	description: string;
	/** Social image: a path/URL string or an imported Astro image. Defaults to /og-default.png. */
	image?: ImageMetadata | string;
	lang?: Locale;
	/** Explicit equivalent URLs (paths) per locale. Omit a locale when no translation exists. */
	alternates?: Partial<Record<Locale, string>>;
	type?: 'website' | 'article';
	noindex?: boolean;
	/** Override canonical (path or absolute URL). */
	canonical?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
}

const {
	title,
	description,
	image,
	lang = getLangFromUrl(Astro.url),
	alternates,
	type = 'website',
	noindex = false,
	canonical: canonicalProp,
	publishedTime,
	modifiedTime,
} = Astro.props;

const site = Astro.site!;
const abs = (path: string | URL) => new URL(path, site).href;

const pageTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const canonical = abs(canonicalProp ?? Astro.url.pathname);
const imageSrc = typeof image === 'string' ? image : (image?.src ?? DEFAULT_OG_IMAGE);
const ogImage = abs(imageSrc);

// hreflang: explicit alternates win; otherwise only exact section mappings are advertised.
const hreflangs = alternates
	? (Object.entries(alternates) as [Locale, string][]).map(([l, p]) => [l, abs(p)] as const)
	: locales.flatMap((l) => {
			if (l === lang) return [[l, canonical] as const];
			const m = switchLocalePath(Astro.url.pathname, l);
			return m.exact ? [[l, abs(m.path)] as const] : [];
		});
const hasAlternates = hreflangs.length > 1;
const defaultAlt = hreflangs.find(([l]) => l === 'es')?.[1] ?? canonical;

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		'@id': `${site.href}#person`,
		name: AUTHOR.name,
		jobTitle: AUTHOR.jobTitle,
		url: site.href,
		email: `mailto:${AUTHOR.email}`,
		sameAs: AUTHOR.sameAs,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		url: site.href,
		name: SITE_NAME,
		inLanguage: lang,
		publisher: { '@id': `${site.href}#person` },
	},
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta name="author" content={AUTHOR.name} />
<meta name="generator" content={Astro.generator} />

<!-- Theme: set before first paint to avoid a flash. No attribute = follow the OS. -->
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
<script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
	document.documentElement.classList.add('js');
	try {
		var t = localStorage.getItem(key);
		if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
	} catch (e) {}
</script>

<!-- Icons, feeds, sitemap -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={abs('/rss.xml')} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Self-hosted fonts (declared in global.css); preload the critical faces -->
<link rel="preload" href="/fonts/dmsans-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/dmserifdisplay-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/dmmono-400.woff2" as="font" type="font/woff2" crossorigin />

<!-- Language alternates -->
{hasAlternates && hreflangs.map(([l, href]) => <link rel="alternate" hreflang={l} href={href} />)}
{hasAlternates && <link rel="alternate" hreflang="x-default" href={defaultAlt} />}

<!-- Open Graph -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={lang === 'es' ? 'es_CL' : 'en_US'} />
{hreflangs.filter(([l]) => l !== lang).map(([l]) => <meta property="og:locale:alternate" content={l === 'es' ? 'es_CL' : 'en_US'} />)}
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
