---
// Global <head>: styles, fonts, theme bootstrap, SEO, social cards, structured data.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import me from '../assets/me.png';
import { AUTHOR, DEFAULT_OG_IMAGE, SITE_NAME, THEME_COLOR, THEME_STORAGE_KEY } from '../consts';
import { locales, type Locale } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
import { switchLocalePath } from '../i18n/routes';
import { hasOgCard, ogImagePath } from '../lib/og';

interface Props {
	title: string;
	description: string;
	/** Social image: a path/URL string or an imported Astro image. Defaults to /og-default.png. */
	image?: ImageMetadata | string;
	lang?: Locale;
	/** Explicit equivalent URLs (paths) per locale. Omit a locale when no translation exists. */
	alternates?: Partial<Record<Locale, string>>;
	type?: 'website' | 'article';
	noindex?: boolean;
	/** Override canonical (path or absolute URL). */
	canonical?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	/** Extra schema.org nodes for this page (Article, ProfilePage, BreadcrumbList...). */
	schema?: Record<string, unknown>[];
}

const {
	title,
	description,
	image,
	lang = getLangFromUrl(Astro.url),
	alternates,
	type = 'website',
	noindex = false,
	canonical: canonicalProp,
	publishedTime,
	modifiedTime,
	schema = [],
} = Astro.props;

const site = Astro.site!;
const abs = (path: string | URL) => new URL(path, site).href;

const pageTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
// Pages are served with a trailing slash; keep canonicals consistent with that.
const withSlash = (p: string) => (p.endsWith('/') || /\.[a-z0-9]+$/i.test(p) ? p : `${p}/`);
const canonical = abs(withSlash(canonicalProp ?? Astro.url.pathname));
const pageCard = (await hasOgCard(Astro.url.pathname)) ? ogImagePath(Astro.url.pathname) : DEFAULT_OG_IMAGE;
const imageSrc = typeof image === 'string' ? image : (image?.src ?? pageCard);
const ogImage = abs(imageSrc);

// hreflang: explicit alternates win; otherwise only exact section mappings are advertised.
const hreflangs = alternates
	? (Object.entries(alternates) as [Locale, string][]).map(([l, p]) => [l, abs(p)] as const)
	: locales.flatMap((l) => {
			if (l === lang) return [[l, canonical] as const];
			const m = switchLocalePath(Astro.url.pathname, l);
			return m.exact ? [[l, abs(withSlash(m.path))] as const] : [];
		});
const hasAlternates = hreflangs.length > 1;
const defaultAlt = hreflangs.find(([l]) => l === 'es')?.[1] ?? canonical;

const photo = await getImage({ src: me, width: 460, format: 'jpg' });
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${site.href}#person`,
			name: AUTHOR.name,
			jobTitle: AUTHOR.jobTitle,
			description: AUTHOR.description[lang],
			url: site.href,
			image: abs(photo.src),
			email: `mailto:${AUTHOR.email}`,
			address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' },
			alumniOf: AUTHOR.alumniOf.map((name) => ({ '@type': 'EducationalOrganization', name })),
			knowsAbout: AUTHOR.knowsAbout,
			knowsLanguage: ['es', 'en'],
			sameAs: AUTHOR.sameAs,
		},
		{
			'@type': 'WebSite',
			'@id': `${site.href}#website`,
			url: site.href,
			name: SITE_NAME,
			inLanguage: ['es', 'en'],
			publisher: { '@id': `${site.href}#person` },
		},
		...schema.map((node) => ({ inLanguage: lang, ...node })),
	],
};
const gaId = import.meta.env.PUBLIC_GA4_ID;
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta name="author" content={AUTHOR.name} />
<meta name="generator" content={Astro.generator} />
{gscToken && <meta name="google-site-verification" content={gscToken} />}

<!-- Theme: set before first paint to avoid a flash. No attribute = follow the OS. -->
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
<script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
	document.documentElement.classList.add('js');
	try {
		var t = localStorage.getItem(key);
		if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
	} catch (e) {}
</script>

<!-- Icons, feeds, sitemap -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={abs('/rss.xml')} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Self-hosted fonts (declared in global.css); preload the critical faces -->
<link rel="preload" href="/fonts/dmsans-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/dmserifdisplay-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/dmserifdisplay-400-italic.woff2" as="font" type="font/woff2" crossorigin />

<!-- Language alternates -->
{hasAlternates && hreflangs.map(([l, href]) => <link rel="alternate" hreflang={l} href={href} />)}
{hasAlternates && <link rel="alternate" hreflang="x-default" href={defaultAlt} />}

<!-- Open Graph -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:locale" content={lang === 'es' ? 'es_CL' : 'en_US'} />
{hreflangs.filter(([l]) => l !== lang).map(([l]) => <meta property="og:locale:alternate" content={l === 'es' ? 'es_CL' : 'en_US'} />)}
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Google Analytics 4 (only when PUBLIC_GA4_ID is set at build time) -->
{gaId && (
	<script is:inline define:vars={{ gaId }}>
		// gtag queues calls right away; the 180 KB library loads once the page is idle.
		window.dataLayer = window.dataLayer || [];
		window.gtag = function () { dataLayer.push(arguments); };
		gtag('js', new Date());
		gtag('config', gaId);
		addEventListener('load', function () {
			(window.requestIdleCallback || setTimeout)(function () {
				var s = document.createElement('script');
				s.async = true;
				s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
				document.head.appendChild(s);
			}, { timeout: 3000 });
		});
	</script>
)}
