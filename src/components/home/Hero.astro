---
import { Picture } from 'astro:assets';
import me from '../../assets/me.png';
import type { Locale } from '../../i18n/ui';
import { profile, copy, cvHref, contact } from '../../data/profile';

interface Props { lang: Locale }
const { lang } = Astro.props;
const { hero } = profile;
const h = hero.headline[lang];
---

<section id="about" class="hero">
  <div class="hero__text">
    <h1 class="hero__title">{h.before} <em>{h.em}</em> {h.after}</h1>
    <p class="hero__lead">{hero.lead[lang]}</p>
    <p class="hero__now">{hero.now[lang]}</p>
    <div class="hero__cta">
      <a class="hero__btn hero__btn--primary" href="#contact">{copy.emailMe[lang]}</a>
      <a class="hero__link" href={contact.linkedin.url} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a class="hero__link" href={cvHref[lang]} download>{copy.downloadCv[lang]} ↓</a>
    </div>
  </div>
  <figure class="hero__photo">
    <Picture
      src={me}
      alt={profile.photoAlt[lang]}
      formats={['avif', 'webp']}
      widths={[220, 440]}
      sizes="(max-width: 860px) 140px, 220px"
      width={220}
      height={220}
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
  </figure>
</section>

<style>
  .hero {
    padding-top: clamp(56px, 9vw, 112px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 24px clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .hero__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(34px, 5.2vw, 64px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 28px;
    text-wrap: balance;
  }
  .hero__title em { font-style: italic; color: var(--accent); }
  .hero__lead {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.65;
    color: var(--ink-muted);
    max-width: 58ch;
    margin: 0 0 20px;
    text-wrap: pretty;
  }
  .hero__now {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
    max-width: 58ch;
    margin: 0 0 32px;
    padding-left: 14px;
    border-left: 2px solid var(--accent);
  }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .hero__btn {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--rule);
    padding: 13px 20px;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .hero__btn:hover { border-color: var(--ink); }
  .hero__btn--primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .hero__btn--primary:hover { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .hero__link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    padding: 13px 6px;
  }
  .hero__link:hover { color: var(--ink); }
  .hero__photo { margin: 0; grid-column: 2; grid-row: 1; }
  .hero__photo :global(.hero__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    border-radius: 50%;
    filter: grayscale(8%);
  }
  @media (max-width: 860px) {
    .hero { grid-template-columns: minmax(0, 1fr) 120px; }
    .hero__text { grid-column: 1 / -1; grid-row: 2; }
    .hero__photo { grid-column: 1; grid-row: 1; max-width: 120px; }
  }
</style>
