---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import { getTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import { routePath } from '../../i18n/routes';
import { copy } from '../../data/profile';
import { services } from '../../data/services';
import { serviceHref } from '../services/labels';
import { profilePage } from '../../lib/schema';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getTranslations(lang);

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-CL' : 'en-US', { year: 'numeric', month: 'short' });
---

<BaseLayout title={t('site.title')} description={t('site.description')} lang={lang} schema={[profilePage(Astro.site!, Astro.url.pathname)]}>

  <Hero lang={lang} />

  <section id="services" class="home-section">
    <div class="section-label section-label--split">
      <span>{t('nav.services')}</span>
      <a class="section-more" href={`${routePath(lang, 'services')}/`}>{copy.browseServices[lang]}</a>
    </div>
    <p class="services-lead">{copy.servicesLead[lang]}</p>
    <div class="concept-list">
      {services.map((s, i) => (
        <a href={serviceHref(lang, s.slug)} class="concept-item">
          <div class="concept-area">0{i + 1}</div>
          <div>
            <div class="concept-title">{s.name[lang]}</div>
            <p class="concept-summary">{s.description[lang]}</p>
          </div>
          <div class="work-arrow">↗</div>
        </a>
      ))}
    </div>
  </section>

  {allPosts.length > 0 && (
    <section id="writing" class="home-section">
      <div class="section-label section-label--split">
        <span>{copy.writing[lang]}</span>
        <a class="section-more" href={routePath(lang, 'blog')}>{copy.viewAll[lang]}</a>
      </div>
      <div class="writing-list">
        {allPosts.slice(0, 4).map(post => (
          <a href={`${routePath(lang, 'blog', post.id)}/`} class="writing-item plain-link">
            <div class="writing-date">{dateFmt.format(post.data.pubDate)}</div>
            <div>
              <div class="writing-title">{post.data.title}</div>
              {post.data.description && <p class="writing-excerpt">{post.data.description}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .home-section { padding-top: clamp(64px, 9vw, 100px); }
  .services-lead { max-width: 62ch; margin: 0 0 var(--space-5); color: var(--ink-muted); line-height: var(--leading-body); }
  .home-section:last-of-type { padding-bottom: 120px; }
  .plain-link { text-decoration: none; color: inherit; }
  .section-label--split { justify-content: space-between; }
  .section-label--split::after { display: none; }
  .section-more {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .section-more:hover { color: var(--ink); }
</style>
