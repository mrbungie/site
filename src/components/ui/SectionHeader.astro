---
interface Props {
	title: string;
	subtitle?: string;
	href?: string;
	linkText?: string;
	class?: string;
}

const { title, subtitle, href, linkText, class: className } = Astro.props;
---

<div class:list={['mb-10', className]}>
	<div class="section-label" style="justify-content: space-between;">
		<span>{title}</span>
		{href && (
			<a
				href={href}
				style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); text-decoration: none; transition: color 0.2s; display: flex; align-items: center; gap: 6px;"
				onmouseover="this.style.color='var(--ink)'"
				onmouseout="this.style.color='var(--ink-muted)'"
			>
				{linkText || 'Ver todo'} →
			</a>
		)}
	</div>
	{subtitle && (
		<p style="font-size: 15px; color: var(--ink-muted); line-height: 1.7; max-width: 540px; margin-top: 8px;">
			{subtitle}
		</p>
	)}
</div>
