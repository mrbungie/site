---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import me from '../../assets/me.png';
import type { Locale } from '../../i18n/ui';
import { profile, copy, contact, cvHref } from '../../data/profile';
import { profilePage } from '../../lib/schema';

interface Props { lang: Locale }
const { lang } = Astro.props;
const other: Locale = lang === 'es' ? 'en' : 'es';
const t = profile.teaching;
---

<BaseLayout title={copy.aboutTitle[lang]} description={copy.aboutDesc[lang]} lang={lang} schema={[profilePage(Astro.site!, Astro.url.pathname)]}>
  <section class="about-page">
    <div class="section-label">{copy.about[lang]}</div>
    <div class="about-grid">
      <div>
        <h1 class="about-headline">{profile.name}</h1>
        {profile.bio[lang].map(p => <p class="about-body">{p}</p>)}
        <div class="about-actions">
          <a class="cv-download" href={cvHref[lang]} download>{copy.downloadCvFull[lang]}</a>
          <a class="cv-download" href={cvHref[other]} download>{lang === 'es' ? 'CV in English ↓' : 'CV en español ↓'}</a>
        </div>
      </div>
      <Picture
        src={me}
        alt={profile.photoAlt[lang]}
        formats={['avif', 'webp']}
        widths={[200, 400]}
        sizes="(max-width: 900px) 140px, 200px"
        width={200}
        height={200}
        loading="eager"
        class="about-photo"
      />
    </div>

    <div class="resume-section about-block">
      <div class="resume-section-title">{copy.experience[lang]}</div>
      {profile.experience.map(e => (
        <div class="resume-item">
          <div class="resume-period">{e.period[lang]}</div>
          <div>
            <div class="resume-org">{e.org}</div>
            <div class="resume-title-role">{e.role[lang]}</div>
            <p class="resume-detail">{e.summary[lang]}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="resume-section">
      <div class="resume-section-title">{copy.teaching[lang]}</div>
      <div class="resume-item">
        <div class="resume-period">{t.period[lang]}</div>
        <div>
          <div class="resume-org">{t.org[lang]}</div>
          <div class="resume-title-role">{t.role[lang]}</div>
          <p class="resume-detail">{t.summary[lang]}</p>
        </div>
      </div>
    </div>

    <div class="resume-section">
      <div class="resume-section-title">{copy.education[lang]}</div>
      {profile.education.map(e => (
        <div class="resume-item">
          <div class="resume-period">{e.period}</div>
          <div>
            <div class="resume-org">{e.org}</div>
            <div class="resume-title-role">{e.degree[lang]}</div>
            <p class="resume-detail">{e.note[lang]}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="resume-section">
      <div class="resume-section-title">{copy.skills[lang]}</div>
      <dl class="skills">
        {profile.skills.map(s => (
          <div class="skills__row"><dt>{s.label[lang]}</dt><dd>{s.items[lang]}</dd></div>
        ))}
      </dl>
    </div>

    <p class="about-contact">
      <a href={`mailto:${contact.email}`}>{contact.email}</a> ·
      <a href={contact.linkedin.url} target="_blank" rel="noopener">LinkedIn</a> ·
      <a href={contact.github.url} target="_blank" rel="noopener">GitHub</a>
    </p>
  </section>
</BaseLayout>

<style>
  .about-page :global(.about-photo) { width: 100%; max-width: 200px; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 50%; display: block; }
  .about-page { padding-top: clamp(56px, 8vw, 100px); padding-bottom: 80px; max-width: 820px; }
  .about-grid { grid-template-columns: minmax(0, 1fr) 200px; }
  .about-headline { font-size: clamp(36px, 5vw, 56px); letter-spacing: -0.02em; }
  .about-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 8px; }
  .about-actions .cv-download { margin-top: 12px; }
  .about-block { margin-top: 64px; }
  .skills { margin: 0; display: flex; flex-direction: column; gap: 12px; font-size: 13px; line-height: 1.7; }
  .skills__row { display: grid; grid-template-columns: 160px 1fr; gap: 20px; }
  .skills dt { color: var(--ink); font-weight: 500; }
  .skills dd { margin: 0; color: var(--ink-muted); }
  .about-contact { font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); margin-top: 24px; }
  .about-contact a { color: var(--ink); }
  @media (max-width: 640px) {
    .skills__row { grid-template-columns: 1fr; gap: 2px; }
  }
  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-page :global(picture) { grid-row: 1; }
    .about-page :global(.about-photo) { max-width: 140px; }
  }
</style>
