---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import me from '../../assets/me.png';
import type { Locale } from '../../i18n/ui';
import { profile, copy, contact, cvHref } from '../../data/profile';
import { profilePage } from '../../lib/schema';
import { routePath } from '../../i18n/routes';
import Career from './Career.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const other: Locale = lang === 'es' ? 'en' : 'es';
const t = profile.teaching;
const pub = profile.publication;
const cert = profile.certification;
---

<BaseLayout title={copy.aboutTitle[lang]} description={copy.aboutDesc[lang]} lang={lang} schema={[profilePage(Astro.site!, Astro.url.pathname)]}>
  <section class="about-page">
    <div class="section-label">{copy.about[lang]}</div>
    <div class="about-grid">
      <div>
        <h1 class="about-headline">{profile.name}</h1>
        {profile.bio[lang].map(p => <p class="about-body">{p}</p>)}
        <div class="about-actions">
          <a class="cv-download about-talk" href={`${routePath(lang, 'contact')}/`}>{lang === 'es' ? 'Conversemos →' : "Let's talk →"}</a>
          <a class="cv-download" href={cvHref[lang]} target="_blank" rel="noopener">{copy.downloadCvFull[lang]}</a>
          <a class="cv-download" href={cvHref[other]} target="_blank" rel="noopener">{lang === 'es' ? 'CV in English ↗' : 'CV en español ↗'}</a>
        </div>
      </div>
      <Picture
        src={me}
        alt={profile.photoAlt[lang]}
        formats={['avif', 'webp']}
        widths={[200, 400]}
        sizes="(max-width: 900px) 140px, 200px"
        width={200}
        height={200}
        loading="eager"
        class="about-photo"
      />
    </div>

    <dl class="glance about-block" aria-label={copy.glance[lang]}>
      {profile.glance.map(g => (
        <div class="glance__item"><dt>{g.label[lang]}</dt><dd>{g.value[lang]}</dd></div>
      ))}
    </dl>

    <section class="resume-section about-block">
      <h2 class="resume-section-title">{copy.experience[lang]}</h2>
      <Career lang={lang} />
    </section>

    <section class="resume-section">
      <h2 class="resume-section-title">{copy.teaching[lang]}</h2>
      <div class="resume-item">
        <div class="resume-period">{t.period[lang]}</div>
        <div>
          <div class="resume-org">{t.org[lang]}</div>
          <div class="resume-title-role">{t.role[lang]}</div>
          <p class="resume-detail">{t.summary[lang]}</p>
        </div>
      </div>
    </section>

    <section class="resume-section">
      <h2 class="resume-section-title">{copy.education[lang]}</h2>
      {profile.education.map(e => (
        <div class="resume-item">
          <div class="resume-period">{e.period}</div>
          <div>
            <div class="resume-org">{e.org}</div>
            <div class="resume-title-role">{e.degree[lang]}</div>
            <p class="resume-detail">{e.note[lang]}</p>
          </div>
        </div>
      ))}
    </section>

    <section class="resume-section">
      <h2 class="resume-section-title">{copy.publications[lang]}</h2>
      <div class="resume-item">
        <div class="resume-period">{pub.year}</div>
        <div>
          <div class="resume-org">{pub.venue}</div>
          <div class="resume-title-role">{pub.title}</div>
          <p class="resume-detail">{pub.authors} <a class="about-link" href={pub.url} target="_blank" rel="noopener">{copy.readPaper[lang]}</a></p>
        </div>
      </div>
      <div class="resume-item">
        <div class="resume-period">{cert.period}</div>
        <div>
          <div class="resume-org">{cert.org}</div>
          <div class="resume-title-role">{cert.name[lang]}</div>
        </div>
      </div>
    </section>

    <section class="resume-section">
      <h2 class="resume-section-title">{copy.skills[lang]}</h2>
      <dl class="skills">
        {profile.skills.map(s => (
          <div class="skills__row"><dt>{s.label[lang]}</dt><dd>{s.items[lang]}</dd></div>
        ))}
      </dl>
    </section>

    <p class="about-contact">
      <a href={`mailto:${contact.email}`}>{contact.email}</a> ·
      <a href={contact.linkedin.url} target="_blank" rel="noopener">LinkedIn</a> ·
      <a href={contact.github.url} target="_blank" rel="noopener">GitHub</a>
    </p>
  </section>
</BaseLayout>

<style>
  .about-page :global(.about-photo) { width: 100%; max-width: 200px; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 50%; display: block; }
  .about-page { padding-top: clamp(56px, 8vw, 100px); padding-bottom: 80px; max-width: 820px; }
  .about-grid { grid-template-columns: minmax(0, 1fr) 200px; }
  .about-headline { font-size: clamp(36px, 5vw, 56px); letter-spacing: -0.02em; }
  .about-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 8px; }
  .about-actions .cv-download { margin-top: 12px; }
  .about-actions .about-talk { background: var(--ink); color: var(--bg); }
  .about-actions .about-talk:hover { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .about-block { margin-top: 64px; }
  .glance { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5) var(--space-6); margin-bottom: 0; }
  .glance dt { margin-bottom: 4px; font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--ink-faint); }
  .glance dd { margin: 0; font-size: var(--text-sm); line-height: 1.5; color: var(--ink); text-wrap: pretty; }
  .about-link { color: var(--accent); white-space: nowrap; }
  .skills { margin: 0; display: flex; flex-direction: column; gap: 12px; font-size: 13px; line-height: 1.7; }
  .skills__row { display: grid; grid-template-columns: 160px 1fr; gap: 20px; }
  .skills dt { color: var(--ink); font-weight: 500; }
  .skills dd { margin: 0; color: var(--ink-muted); }
  .about-contact { font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); margin-top: 24px; }
  .about-contact a { color: var(--ink); }
  @media (max-width: 640px) {
    .glance { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
    .skills__row { grid-template-columns: 1fr; gap: 2px; }
  }
  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-page :global(picture) { grid-row: 1; }
    .about-page :global(.about-photo) { max-width: 140px; }
  }
</style>
