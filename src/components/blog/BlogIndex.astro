---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from './PostList.astro';
import { getTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<BaseLayout title={`${t('blog.title')} | Germán Oviedo`} description={t('blog.subtitle')} lang={lang}>
	<header class="blog-header">
		<h1>{t('blog.title')}</h1>
		<p>{t('blog.subtitle')}</p>
		{lang !== 'es' && <p class="note">{t('blog.es-only')}</p>}
	</header>
	<PostList lang={lang} />
</BaseLayout>

<style>
	.blog-header { max-width: 42rem; margin-bottom: 2.5rem; }
	h1 {
		margin: 0 0 0.75rem; font-family: var(--font-serif); font-weight: 400;
		font-size: clamp(2.25rem, 5vw, 3.25rem); line-height: 1.1;
	}
	p { margin: 0; color: var(--ink-muted); font-size: 1.05rem; }
	.note { margin-top: 0.5rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); }
</style>
