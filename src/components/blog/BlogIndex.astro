---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from './PostList.astro';
import { getTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import { getPosts, isTranslation } from '../../utils/blog';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const untranslated = lang !== 'es' && (await getPosts(lang)).some((p) => !isTranslation(p));
---

<BaseLayout title={`${t('blog.title')} | Germán Oviedo`} description={t('blog.subtitle')} lang={lang}>
	<section class="page">
		<div class="section-label">{t('blog.title')}</div>
		<h1 class="page-title">{t('blog.headline')}</h1>
		<p class="page-lead">{t('blog.lead')}</p>
		{untranslated && <p class="note">{t('blog.es-only')}</p>}
		<PostList lang={lang} />
	</section>
</BaseLayout>

<style>
	.note { margin: calc(-1 * var(--space-5)) 0 var(--space-6); font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--accent); }
</style>
