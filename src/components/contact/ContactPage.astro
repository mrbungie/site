---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from './ContactForm.astro';
import type { Locale } from '../../i18n/ui';
import { routePath } from '../../i18n/routes';
import { profile, copy, contact } from '../../data/profile';
import { breadcrumbs, personRef } from '../../lib/schema';

interface Props { lang: Locale }
const { lang } = Astro.props;
const site = Astro.site!;
const path = `${routePath(lang, 'contact')}/`;
const title = { es: 'Contacto · Germán Oviedo', en: 'Contact · Germán Oviedo' }[lang];
const description = {
  es: 'Escríbele a Germán Oviedo por un rol de liderazgo en datos e IA o por un proyecto de consultoría, en Chile o en el extranjero.',
  en: 'Write to Germán Oviedo about a data and AI leadership role or a consulting project, in Chile or abroad.',
}[lang];
const schema = [
  { '@type': 'ContactPage', url: new URL(path, site).href, about: personRef(site) },
  breadcrumbs(site, [
    { name: profile.name, path: lang === 'es' ? '/' : `/${lang}/` },
    { name: copy.contact[lang], path },
  ]),
];
---

<BaseLayout title={title} description={description} lang={lang} schema={schema}>
  <section class="contact-page">
    <div class="section-label">{copy.contact[lang]}</div>
    <h1 class="contact-headline">{profile.contact.headline[lang]}</h1>
    <p class="contact-body">{profile.contact.body[lang]}</p>
    <ContactForm lang={lang} />
    <div class="contact-links">
      <a class="contact-link-row" href={`mailto:${contact.email}`}>
        <span class="contact-link-label">Email</span>
        <span class="contact-link-value">{contact.email}</span>
      </a>
      <a class="contact-link-row" href={contact.linkedin.url} target="_blank" rel="noopener">
        <span class="contact-link-label">LinkedIn</span>
        <span class="contact-link-value">{contact.linkedin.label}</span>
      </a>
      <a class="contact-link-row" href={contact.github.url} target="_blank" rel="noopener">
        <span class="contact-link-label">GitHub</span>
        <span class="contact-link-value">{contact.github.label}</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page { padding: clamp(56px, 9vw, 100px) 0 120px; max-width: 820px; }
  .contact-page .contact-headline { font-size: var(--text-display); line-height: var(--leading-tight); }
</style>
