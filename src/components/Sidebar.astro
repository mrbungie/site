---
// The single site navigation: fixed rail on desktop, collapsible top bar on mobile.
import { languages, locales, type Locale } from '../i18n/ui';
import { getLangFromUrl, getTranslations } from '../i18n/utils';
import { routePath, switchLocalePath } from '../i18n/routes';
import { AUTHOR, THEME_STORAGE_KEY } from '../consts';

interface Props {
	lang?: Locale;
	/** Explicit equivalent paths per locale (used by the language switcher). */
	alternates?: Partial<Record<Locale, string>>;
}

const { lang = getLangFromUrl(Astro.url), alternates } = Astro.props;
const t = getTranslations(lang);

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const homeHref = lang === 'es' ? '' : `/${lang}`;
const conceptsHref = routePath(lang, 'concepts');
const blogHref = routePath(lang, 'blog');
const startsWith = (href: string) => pathname === href || pathname.startsWith(`${href}/`);

const pages = [
	{ href: routePath(lang, 'about'), label: t('nav.about') },
	{ href: routePath(lang, 'services'), label: t('nav.services') },
	{ href: routePath(lang, 'portfolio'), label: t('nav.portfolio') },
	{ href: blogHref, label: t('nav.blog') },
	{ href: routePath(lang, 'contact'), label: t('nav.contactPage') },
];
const learning = [{ href: conceptsHref, label: t('nav.mlConcepts') }];

const langLinks = locales.map((l) => ({
	l,
	href: alternates?.[l] ?? switchLocalePath(Astro.url.pathname, l).path,
}));
---

<header class="sidebar" id="site-sidebar" data-theme-key={THEME_STORAGE_KEY}>
	<div class="sidebar__bar">
		<a class="sidebar__brand" href={`${homeHref}/`} aria-label={`${AUTHOR.name}, ${t('nav.home')}`}>
			<span class="sidebar-monogram">{AUTHOR.name}</span>
		</a>
		<button
			type="button"
			class="ctrl-btn sidebar__toggle"
			aria-expanded="false"
			aria-controls="site-nav"
			data-label-open={t('nav.menu')}
			data-label-close={t('nav.close')}
		>
			{t('nav.menu')}
		</button>
	</div>

	<div class="sidebar__body" id="site-nav">
		<div class="sidebar-identity">
			<a class="sidebar-name" href={`${homeHref}/`}>Germán<br />Oviedo</a>
			<p class="sidebar-role">{t('site.role')}<br />Santiago · Antofagasta</p>
		</div>

		<nav class="sidebar-nav" aria-label={t('nav.primary')}>
			<ul>
				{pages.map((p) => (
					<li><a href={p.href} aria-current={startsWith(p.href) ? 'page' : undefined}>{p.label}</a></li>
				))}
				<li class="nav-divider" aria-hidden="true"></li>
				{learning.map((p) => (
					<li><a href={p.href} aria-current={startsWith(p.href) ? 'page' : undefined}>{p.label}</a></li>
				))}
			</ul>
		</nav>

		<div class="sidebar-controls">
			<div class="ctrl-group" role="group" aria-label={t('nav.language')}>
				{langLinks.map(({ l, href }) => (
					<a
						href={href}
						class:list={['ctrl-btn', { active: lang === l }]}
						lang={l}
						hreflang={l}
						title={languages[l]}
						aria-current={lang === l ? 'true' : undefined}
					>{l.toUpperCase()}</a>
				))}
			</div>
			<button
				type="button"
				class="ctrl-btn"
				data-theme-toggle
				aria-label={t('nav.theme.label')}
				data-to-dark={t('nav.theme.dark')}
				data-to-light={t('nav.theme.light')}
			>
				<span data-theme-label>{t('nav.theme.dark')}</span>
			</button>
		</div>

		<address class="sidebar-footer">
			<a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a><br />
			<a href={AUTHOR.sameAs[0]} target="_blank" rel="me noopener">LinkedIn</a>
			<span aria-hidden="true"> · </span>
			<a href={AUTHOR.sameAs[1]} target="_blank" rel="me noopener">GitHub</a>
		</address>
	</div>
</header>

<script>
	const root = document.documentElement;
	const sidebar = document.getElementById('site-sidebar')!;
	const key = sidebar.dataset.themeKey || 'go-theme';

	// Theme toggle (explicit choice persists; default follows the OS)
	const toggle = sidebar.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
	const label = toggle.querySelector<HTMLElement>('[data-theme-label]')!;
	const mq = matchMedia('(prefers-color-scheme: dark)');
	const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : mq.matches);
	const paint = () => {
		label.textContent = isDark() ? toggle.dataset.toLight! : toggle.dataset.toDark!;
		toggle.setAttribute('aria-pressed', String(isDark()));
	};
	toggle.addEventListener('click', () => {
		const next = isDark() ? 'light' : 'dark';
		root.dataset.theme = next;
		try { localStorage.setItem(key, next); } catch {}
		paint();
	});
	mq.addEventListener('change', paint);
	paint();

	// Mobile menu
	const menuBtn = sidebar.querySelector<HTMLButtonElement>('.sidebar__toggle')!;
	const setOpen = (open: boolean) => {
		sidebar.dataset.open = String(open);
		menuBtn.setAttribute('aria-expanded', String(open));
		menuBtn.textContent = open ? menuBtn.dataset.labelClose! : menuBtn.dataset.labelOpen!;
	};
	menuBtn.addEventListener('click', () => setOpen(sidebar.dataset.open !== 'true'));
	sidebar.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && sidebar.dataset.open === 'true') { setOpen(false); menuBtn.focus(); }
	});
</script>
